diff --git a/apple/Sources/ExpoModulesJSI/Runtime/WeakRuntimeBox.swift b/apple/Sources/ExpoModulesJSI/Runtime/WeakRuntimeBox.swift
new file mode 100644
index 0000000000000000000000000000000000000000..509a53c3f3107e50b1bf27e31ac58c94273137a6
--- /dev/null
+++ b/apple/Sources/ExpoModulesJSI/Runtime/WeakRuntimeBox.swift
@@ -0,0 +1,16 @@
+// Patched (ios-port): helper that preserves true weak semantics without
+// SE-0481 (weak-let syntax, implemented in Swift 6.3). The box itself is
+// immutable and @unchecked Sendable (same justification as
+// JavaScriptRuntimeExecutor: weak references are safely replaceable by the
+// Objective-C runtime, and JavaScriptRuntime is already @unchecked Sendable).
+internal final class WeakRuntimeBox: @unchecked Sendable {
+  private weak var runtime: JavaScriptRuntime?
+
+  internal init(_ runtime: JavaScriptRuntime?) {
+    self.runtime = runtime
+  }
+
+  internal var value: JavaScriptRuntime? {
+    runtime
+  }
+}
